/*--------------------------------------------------
  Nome      : UNION ALL | TOP | ORDER BY
  Descrição : Une duas consultas retornando a cidade
             com o menor e o maior nome. Tendo como critério
             de desempate a ordem alfabética.
  Data       : 28/07/2026
--------------------------------------------------*/
```sql
SELECT CITY, LEN(CITY)
FROM (
    SELECT TOP 1 CITY
    FROM STATION
    ORDER BY LEN(CITY), CITY
) AS Menor

UNION ALL

SELECT CITY, LEN(CITY)
FROM (
    SELECT TOP 1 CITY
    FROM STATION
    ORDER BY LEN(CITY) DESC, CITY
) AS Maior;
```
